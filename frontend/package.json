{
  "name": "slotbook-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22.20.0 <23",
    "npm": "10.9.4"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc --noEmit --strict --target ES2022 --lib ES2022,DOM,DOM.Iterable --module ESNext --moduleResolution Bundler --esModuleInterop --skipLibCheck --types node playwright.config.ts tests/fixtures/api.ts tests/scaffold.spec.ts",
    "test": "npm run typecheck && playwright test",
    "preview": "vite preview",
    "generate:api": "openapi-typescript ../contracts/tsp-output/@typespec/openapi3/openapi.yaml -o src/api/schema.d.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "openapi-types": "12.1.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "yaml": "2.9.1"
  }
}
