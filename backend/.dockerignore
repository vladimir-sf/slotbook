# Default-deny build context; only component code, tests and locked config enter.
**
!requirements.txt
!requirements.lock
!pyproject.toml
!pytest.ini
!app/
!app/**
!tests/
!tests/**
# Future Alembic sources can use the same image; none are implemented by T007.
!alembic.ini
!migrations/
!migrations/**

# Apply again inside the admitted source trees, including all nested directories.
**/.env
**/.env.*
**/.venv
**/venv
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.cache
**/.git
**/.idea
**/.codex
**/.agents
**/node_modules
**/dist
**/build
**/test-results
**/playwright-report
**/htmlcov
**/.coverage*
**/coverage*
**/raw
**/control
**/artifacts
**/dumps
**/secrets
**/credentials*
**/manifest*.json
**/candidate*.json
**/*.log
**/*.xml
**/*.dump
**/*.sql
**/*.sqlite*
**/*.pem
**/*.key
**/.DS_Store
